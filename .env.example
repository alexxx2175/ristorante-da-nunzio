# La password del pannello /admin, condivisa con il locale.
# Senza questa variabile la pagina non si apre: e' voluto.
ADMIN_PASSWORD=

# Solo in produzione (Vercel): il token del deposito Blob dove finiscono
# l'elenco dei piatti e le fotografie caricate. Su Vercel lo si ottiene creando
# uno store Blob dal pannello del progetto — la variabile compare da sola.
# In locale lasciala vuota: senza token si scrive su disco, sotto .dati/.
BLOB_READ_WRITE_TOKEN=

# Facoltativa: la chiave dell'API di Anthropic, con cui il pannello propone da
# solo la traduzione tedesca e inglese di un piatto nuovo. Si prende da
# console.anthropic.com. Senza, il pannello funziona lo stesso: i due campi
# restano da compilare a mano e il bottone «Proponi traduzione» non compare.
ANTHROPIC_API_KEY=
